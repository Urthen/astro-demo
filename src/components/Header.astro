---

import HeaderLink from './HeaderLink.astro';

interface Link {
    href: string;
    text: string;
}

const links: Link[] = [
    {
        href: '/',
        text: 'Home',
    },
    {
        href: '/todo',
        text: 'Todo',
    },
    {
        href: '/products',
        text: 'Products',
    },
];
---

<header id="header">
    <div id="title">My Astro App</div>
    <nav>
        <ul>
            {links.map((link) => (
                <HeaderLink link={link} />
            ))}
        </ul>
    </nav>
</header>

<style>
    #header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0.5em 1em;
        padding: 0.75em 1em;
        border-bottom: 1px solid #e2e2e2;
    }

    #title {
        font-size: 1.25em;
        font-weight: 600;
    }

    nav ul {
        display: flex;
        gap: 1.5em;
        list-style: none;
        margin: 0;
        padding: 0;
    }
</style>
