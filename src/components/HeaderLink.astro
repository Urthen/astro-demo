---

interface Props {
    link: {
        href: string;
        text: string;
    };
}

const { link } = Astro.props as Props;

---

<li><a href={link.href}>{link.text}</a></li>

<style>
    a {
        color: inherit;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }
</style>
