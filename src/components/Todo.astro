---
import { getCollection } from 'astro:content';

const todoItems = await getCollection('todoItems');
---

<div id="container">
	<h1>Todo list</h1>
    <p>Todo list page!</p>
    <li>
        {todoItems.map((item) => (
            <div>
                <a href={`items/${item.id}`}>
                    <h2>{item.data.name}</h2>
                </a>
                <p>{item.data.description}</p>
                {item.data.completed ? <p>Completed</p> : <p>Not completed</p>}
            </div>
        ))}
    </li>
</div>

<style>
	#container {
		margin: 1em;
	}
</style>
