---
export const prerender = false;

import type { TodoItem } from '../types';

interface Props {
    items: TodoItem[];
}

const { items } = Astro.props as Props;

---

<div id="container">
	<h1>Todo list</h1>
    <p>Todo list page!</p>
    <li>
        {items.map((item) => (
            <div>
                <a href={`/items/${item.id}`}>
                    <h2>{item.title}</h2>
                </a>
                <p>{item.description}</p>
                {item.completed ? <p>Completed</p> : <p>Not completed</p>}
            </div>
        ))}
    </li>
</div>

<style>
	#container {
		margin: 1em;
	}
</style>
